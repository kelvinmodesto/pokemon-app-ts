# MongoDB Configuration
MONGODB_URI=mongodb://pokemon_user:pokemon_pass@localhost:27017/pokemon_center
MONGODB_DB_NAME=pokemon_center
MONGODB_USERNAME=pokemon_user
MONGODB_PASSWORD=pokemon_pass

# MongoDB Docker Configuration
MONGODB_PORT=27017
MONGODB_ROOT_USERNAME=admin
MONGODB_ROOT_PASSWORD=password

# Mongo Express Configuration
MONGO_EXPRESS_PORT=8081
MONGO_EXPRESS_BASICAUTH=true
MONGO_EXPRESS_USERNAME=admin
MONGO_EXPRESS_PASSWORD=admin

# Server Configuration
PORT=3000
NODE_ENV=development

# Frontend Configuration
FRONTEND_URL=http://localhost:5173

# Application Settings
API_PREFIX=api/v1
